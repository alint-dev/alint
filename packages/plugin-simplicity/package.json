{
  "name": "@alint-js/plugin-simplicity",
  "type": "module",
  "version": "0.7.2",
  "description": "Model-backed alint rules for duplicated and needless helper functions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/plugin-simplicity"
  },
  "keywords": [
    "alint",
    "lint",
    "plugin",
    "code-analysis",
    "duplication",
    "ai"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@alint-js/agent-apeira": "workspace:*",
    "@alint-js/core": "workspace:*",
    "@alint-js/languages": "workspace:*",
    "@alint-js/plugin": "workspace:*",
    "@alint-js/tools-fs": "workspace:*",
    "@moeru/std": "catalog:",
    "minimatch": "catalog:",
    "pathe": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:"
  }
}
