{
  "name": "@alint-js/config",
  "type": "module",
  "version": "0.7.3",
  "description": "Configuration loading and setup utilities for alint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/config"
  },
  "keywords": [
    "alint",
    "lint",
    "configuration",
    "ai"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@alint-js/agent-apeira": "workspace:*",
    "@alint-js/core": "workspace:*",
    "@alint-js/tools-fs": "workspace:*",
    "@alint-js/utils": "workspace:*",
    "@moeru/std": "catalog:",
    "@package-json/types": "catalog:",
    "apeira": "catalog:",
    "c12": "catalog:",
    "chokidar": "catalog:",
    "es-toolkit": "catalog:",
    "jiti": "catalog:",
    "minimatch": "catalog:",
    "ofetch": "catalog:",
    "pathe": "catalog:",
    "resolve.exports": "catalog:",
    "smol-toml": "catalog:",
    "tar-stream": "catalog:",
    "valibot": "catalog:",
    "xdg-basedir": "catalog:"
  },
  "devDependencies": {
    "h3": "catalog:"
  }
}
