{
  "name": "@alint-js/cli",
  "type": "module",
  "version": "0.7.3",
  "description": "Agentic code analysis CLI for model-backed lint rules",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "alint",
    "lint",
    "linter",
    "ai",
    "code-analysis",
    "cli"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./lsp-commands": {
      "types": "./dist/lsp-commands.d.mts",
      "default": "./dist/lsp-commands.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "alint": "./dist/bin/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "alint": "node ./dist/bin/index.mjs",
    "bench": "vitest bench --config vitest.config.ts",
    "build": "tsdown",
    "build:binary": "tsdown --config tsdown.binary.config.ts --config-loader unrun",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@alint-js/config": "workspace:*",
    "@alint-js/core": "workspace:*",
    "@alint-js/model-adapter-acp": "workspace:*",
    "@alint-js/utils": "workspace:*",
    "@clack/prompts": "catalog:",
    "@moeru/std": "catalog:",
    "cac": "catalog:",
    "cli-spinners": "catalog:",
    "date-fns": "catalog:",
    "diff": "catalog:",
    "fast-string-truncated-width": "catalog:",
    "fast-string-width": "catalog:",
    "gitignore-fs": "catalog:",
    "minimatch": "catalog:",
    "pathe": "catalog:",
    "table": "catalog:",
    "tinyexec": "catalog:",
    "tinyrainbow": "catalog:",
    "vscode-languageserver": "catalog:"
  },
  "devDependencies": {
    "@pnpm/find-workspace-dir": "catalog:",
    "local-pkg": "catalog:",
    "mlly": "catalog:"
  }
}
