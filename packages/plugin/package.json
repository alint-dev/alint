{
  "name": "@alint-js/plugin",
  "type": "module",
  "version": "0.7.3",
  "description": "Side-effect-free plugin authoring facade for alint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/plugin"
  },
  "keywords": [
    "alint",
    "lint",
    "plugin",
    "sdk",
    "ai"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@alint-js/core": "workspace:*",
    "valibot": "catalog:"
  }
}
