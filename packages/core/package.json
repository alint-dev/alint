{
  "name": "@alint-js/core",
  "type": "module",
  "version": "0.7.3",
  "description": "Public rule and plugin SDK and run engine for alint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/core"
  },
  "keywords": [
    "alint",
    "lint",
    "linter",
    "ai",
    "code-analysis",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./agent": {
      "types": "./dist/agent.d.mts",
      "default": "./dist/agent.mjs"
    },
    "./dsl": {
      "types": "./dist/dsl.d.mts",
      "default": "./dist/dsl.mjs"
    },
    "./structured-output": {
      "types": "./dist/structured-output.d.mts",
      "default": "./dist/structured-output.mjs"
    },
    "./languages/js": {
      "types": "./dist/languages-js.d.mts",
      "default": "./dist/languages-js.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "vitest bench --config vitest.config.ts",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@alint-js/utils": "workspace:*",
    "@moeru/std": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "@xsai/generate-text": "catalog:",
    "@xsai/shared-chat": "catalog:",
    "@xsai/stream-text": "catalog:",
    "@xsai/tool": "catalog:",
    "es-toolkit": "catalog:",
    "minimatch": "catalog:",
    "oxc-parser": "catalog:",
    "pathe": "catalog:",
    "proper-lockfile": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/proper-lockfile": "catalog:",
    "effect": "catalog:",
    "sury": "catalog:"
  }
}
