{
  "name": "@alint-js/languages",
  "type": "module",
  "version": "0.7.1",
  "description": "First-party Go, Python, and Rust language support for alint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/languages"
  },
  "keywords": [
    "alint",
    "lint",
    "tree-sitter",
    "go",
    "python",
    "rust"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@alint-js/core": "workspace:*"
  },
  "dependencies": {
    "tree-sitter-wasms": "catalog:",
    "web-tree-sitter": "catalog:"
  },
  "devDependencies": {
    "@alint-js/core": "workspace:*",
    "@alint-js/plugin": "workspace:*"
  }
}
