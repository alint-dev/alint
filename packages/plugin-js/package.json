{
  "name": "@alint-js/plugin-js",
  "type": "module",
  "version": "0.7.0",
  "description": "Model-backed JavaScript and TypeScript review rules for alint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/plugin-js"
  },
  "keywords": [
    "alint",
    "lint",
    "plugin",
    "javascript",
    "typescript",
    "code-analysis",
    "ai"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@alint-js/core": "workspace:*",
    "@alint-js/plugin": "workspace:*",
    "@alint-js/tools-fs": "workspace:*",
    "@valibot/to-json-schema": "catalog:",
    "apeira": "catalog:",
    "valibot": "catalog:"
  }
}
