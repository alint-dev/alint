{
  "name": "@alint-js/tools-fs",
  "type": "module",
  "version": "0.7.0",
  "description": "Filesystem exploration tools for alint agent-powered rules",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/tools-fs"
  },
  "keywords": [
    "alint",
    "agent",
    "tools",
    "filesystem",
    "ai"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@alint-js/core": "workspace:*"
  }
}
