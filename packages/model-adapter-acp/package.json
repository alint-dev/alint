{
  "name": "@alint-js/model-adapter-acp",
  "type": "module",
  "version": "0.7.1",
  "description": "OpenAI-compatible HTTP gateway for Agent Client Protocol coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/model-adapter-acp"
  },
  "keywords": [
    "alint",
    "agent-client-protocol",
    "acp",
    "openai-compatible",
    "ai",
    "gateway"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "h3": "catalog:",
    "tinyexec": "catalog:",
    "valibot": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alint-js/core": "workspace:*"
  }
}
