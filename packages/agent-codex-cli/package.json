{
  "name": "@alint-js/agent-codex-cli",
  "type": "module",
  "version": "0.7.0",
  "description": "Codex CLI-backed agent adapter for alint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/alint.git",
    "directory": "packages/agent-codex-cli"
  },
  "keywords": [
    "alint",
    "agent",
    "ai",
    "codex",
    "cli"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@alint-js/core": "workspace:*"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@openai/codex-sdk": "catalog:"
  },
  "devDependencies": {
    "@alint-js/core": "workspace:*"
  }
}
