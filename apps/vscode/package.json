{
  "name": "@alint-js/vscode",
  "displayName": "alint",
  "type": "module",
  "version": "0.7.1",
  "private": true,
  "description": "Alint integration for VS Code",
  "categories": [
    "Linters"
  ],
  "main": "./dist/index.cjs",
  "files": [
    "dist"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "workspaceContains:alint.config.*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "alint.runFile",
        "title": "Run on Current File",
        "category": "alint"
      },
      {
        "command": "alint.runWorkspace",
        "title": "Run on Workspace",
        "category": "alint"
      },
      {
        "command": "alint.clearCache",
        "title": "Clear Cache",
        "category": "alint"
      }
    ],
    "configuration": {
      "title": "alint",
      "properties": {
        "alint.path": {
          "type": "string",
          "default": "",
          "description": "Path to the alint executable. Leave empty to use the workspace installation, then alint on PATH."
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@alint-js/cli": "workspace:*",
    "@types/vscode": "catalog:",
    "vscode-languageclient": "catalog:"
  },
  "vscode": {
    "name": "alint",
    "publisher": "moeru-ai"
  }
}
